# Public, non-secret address only. Restart/rebuild after changing.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public build: NEXT_PUBLIC_API_BASE_URL=same-origin
# NEXT_PUBLIC_FRONTEND_URL=https://your-exact-demo-host
# SCOPESHIELD_FRONTEND_PROFILE=production (build-time validation)
# Optional unlicensed LOCAL evaluation only. Default is disabled (blank).
# Set to local-evaluation and rebuild for localhost/127.0.0.1 only.
# Strict production profile always disables Studio until licensing is resolved.
NEXT_PUBLIC_SCOPESHIELD_STUDIO=

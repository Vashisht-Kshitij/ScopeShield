# Optional LOCAL development settings. No credentials or account identifiers.
# The guarded Day 24 CLI chooses its own new database and forces these safe modes.
SCOPESHIELD_ENV=local
SCOPESHIELD_AI_PROVIDER=disabled
SCOPESHIELD_AI_ALLOW_LIVE=false
SCOPESHIELD_SECURE_COOKIES=false
SCOPESHIELD_PASSWORD_CONCURRENCY=1
SCOPESHIELD_AI_CONCURRENCY=1
SCOPESHIELD_PDF_CONCURRENCY=1
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
GEMINI_API_KEY=
# Never place provider secrets in frontend NEXT_PUBLIC variables.

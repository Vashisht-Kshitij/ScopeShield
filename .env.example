# From https://developer.paypal.com/ Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
# Use the EMAIL of a PayPal Personal SANDBOX account (Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUYER_EMAIL=buyer@example.com

# Day 4: optional Gemini API access; chat subscriptions are not API credits.
# Keep empty/disabled until the project's active quota and billing tier are checked.
# REST uses JSON MIME mode + an output cap; the full schema is validated locally.
# Multiline quotations match only whitespace changes and retain source offsets.
GEMINI_API_KEY=
SCOPESHIELD_AI_PROVIDER=gemini
# Priority must contain only metadata-verified supported IDs, at most three.
SCOPESHIELD_AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Operator assertion AFTER checking this project's Free-tier allowances in AI Studio.
# Empty excludes every model. Public pricing and metadata do not prove project access.
SCOPESHIELD_AI_FREE_TIER_MODELS=
SCOPESHIELD_AI_ALLOW_LIVE=false
# One request per model; this cap applies across models in one logical operation.
SCOPESHIELD_AI_MAX_MODEL_CALLS=2
SCOPESHIELD_AI_MODEL_TIMEOUT_SECONDS=30
# Optional third model: append gemini-3.8-flash only after separate access/tier review.
# Legacy SCOPESHIELD_AI_MODEL selects one model when AI_MODELS is absent.
# Legacy SCOPESHIELD_AI_MAX_ATTEMPTS is no longer used; same-model retries are disabled.

# Day 8: local HTTP uses HttpOnly + SameSite=Strict. Require Secure with a local TLS proxy.
# Do not set true for plain HTTP development. Keep uvicorn bound to 127.0.0.1.
SCOPESHIELD_SECURE_COOKIES=false

# Day 13: local SQLite, one backend process (OS lock rejects additional workers).
# Fixed UTC minute windows per direct client IP / authenticated account.
SCOPESHIELD_RATE_INGRESS=600
SCOPESHIELD_RATE_READ=600
SCOPESHIELD_RATE_QUERY=60
SCOPESHIELD_RATE_WRITE=120
SCOPESHIELD_RATE_UPLOAD=20
SCOPESHIELD_RATE_EXTRACT=20
SCOPESHIELD_RATE_ANALYZE=20
SCOPESHIELD_RATE_PROVIDER=20
# All attempts, including successful logins, count in the existing 15-minute window.
SCOPESHIELD_LOGIN_IP_ATTEMPTS=40
SCOPESHIELD_LOGIN_ACCOUNT_ATTEMPTS=10
SCOPESHIELD_PASSWORD_CONCURRENCY=2
SCOPESHIELD_BODY_CONCURRENCY=4
SCOPESHIELD_JSON_BODY_BYTES=1048576
SCOPESHIELD_BODY_TIMEOUT_SECONDS=15
SCOPESHIELD_PDF_CONCURRENCY=1
SCOPESHIELD_PDF_TIMEOUT_SECONDS=20
# Original PDFs: retention can be reduced, never increased above these ceilings.
SCOPESHIELD_PDF_STORAGE_BYTES=536870912
SCOPESHIELD_PDF_USER_STORAGE_BYTES=67108864
SCOPESHIELD_RATE_DOCUMENT_DOWNLOAD=10
# Each network attempt, including fallback and failures, reserves nonrefundable capacity.
# Daily windows reset at UTC midnight. These are application limits, not Google quotas.
SCOPESHIELD_AI_USER_DAILY_REQUESTS=20
SCOPESHIELD_AI_APP_DAILY_REQUESTS=60
SCOPESHIELD_AI_USER_DAILY_TOKENS=250000
SCOPESHIELD_AI_APP_DAILY_TOKENS=1000000
SCOPESHIELD_AI_CONCURRENCY=2
# One concurrent AI operation per account; input estimate = full prompt UTF-8 bytes + 128.
SCOPESHIELD_AI_MAX_INPUT_TOKENS=32768
SCOPESHIELD_AI_MAX_OUTPUT_TOKENS=8192
SCOPESHIELD_AI_QUOTA_COOLDOWN_SECONDS=60

# Day 14: local remains the default. Public demos use deploy/production.env.example.
SCOPESHIELD_ENV=local
# Production additionally requires FRONTEND_URL, BACKEND_URL, TRUSTED_PROXIES,
# DEMO_MODE=true, DATA_DIR, STORAGE_ID and an explicit DATABASE_URL (all SCOPESHIELD_).

# Install as /etc/scopeshield/backend.env, owner root, mode 0600. No actual secrets.
SCOPESHIELD_ENV=production
SCOPESHIELD_FRONTEND_URL=https://demo.example.com
SCOPESHIELD_BACKEND_URL=https://demo.example.com
SCOPESHIELD_TRUSTED_PROXIES=127.0.0.1
SCOPESHIELD_SECURE_COOKIES=true
SCOPESHIELD_DEMO_MODE=true
SCOPESHIELD_AI_PROVIDER=disabled
SCOPESHIELD_AI_ALLOW_LIVE=false
SCOPESHIELD_DATA_DIR=/srv/scopeshield-data
SCOPESHIELD_STORAGE_ID=replace-with-volume-identity
SCOPESHIELD_DATABASE_URL=sqlite:////srv/scopeshield-data/scopeshield.db
SCOPESHIELD_PASSWORD_CONCURRENCY=1
SCOPESHIELD_PDF_CONCURRENCY=1
SCOPESHIELD_AI_CONCURRENCY=1
SCOPESHIELD_AI_USER_DAILY_REQUESTS=0
SCOPESHIELD_AI_APP_DAILY_REQUESTS=0
SCOPESHIELD_PDF_STORAGE_BYTES=536870912
SCOPESHIELD_PDF_USER_STORAGE_BYTES=67108864
SCOPESHIELD_RATE_DOCUMENT_DOWNLOAD=10
# No Gemini/PayPal credentials belong in the public judge demo.
